{
  "name": "my-guitar-studies",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "backend:dev": "bun run --watch backend/index.ts",
    "desktop:dev": "npm run build && cd desktop && bunx electrobun dev --watch",
    "desktop:build": "npm run build && cd desktop && bunx electrobun build --env=canary",
    "migrate:firestore": "bun run scripts/migrate-firestore-to-sqlite.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lucide/angular": "^1.9.0",
    "@tailwindcss/postcss": "^4.2.4",
    "daisyui": "^5.5.19",
    "firebase": "^12.18.0",
    "hono": "^4.13.3",
    "ngx-editor": "^19.0.0-beta.1",
    "postcss": "^8.5.10",
    "rxjs": "~7.8.0",
    "smplr": "^0.26.0",
    "tailwindcss": "^4.2.4",
    "tonal": "^6.4.3",
    "tslib": "^2.3.0",
    "vexflow": "^5.0.0",
    "vextab": "^4.0.5",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "@types/bun": "^1.3.14",
    "@types/vextab": "^3.0.4",
    "firebase-admin": "^14.3.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "author": "LorenzoCorbella74"
}
